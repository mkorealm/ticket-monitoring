{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http": "Warning",
        "RateLimiting": "Debug",
        "TicketMonitor.Api.RateLimiting": "Debug"
      }
    }
  },
  "Monitors": [
    {
      "Name": "Docsvision",
      "IsSystem": true,
      "CategoryFilter": "Docsvision",
      "CheckIntervalMinutes": 2,
      "DatabaseFileName": "tickets_docsvision.db",
      "SupportGroupId": 3,
      "Notification": {
        "Channels": [
          {
            "Type": "RocketChat",
            "Enabled": true,
            "Settings": {
              "RedmineCreateFormUrl": "http://ticket-monitor-redmine:8082/redmine/create",
              "GlpiSolutionFormUrl": "http://ticket-monitor-redmine:8082/glpi/solution"
            }
          },
          {
            "Type": "Exchange",
            "Enabled": true,
            "Settings": {}
          }
        ]
      }
    }
  ],
  "Operations": {
    "ServiceName": "TicketMonitor.Api",
    "DatabaseFileName": "operations.db",
    "RetentionDays": 30
  },
  "Email": {
    "SmtpServer": "mail.example.ru",
    "Port": 25,
    "From": "mkorolev@example.ru",
    "To": "mkorolev@example.ru"
  },
  "GLPI": {
    "TimeoutSeconds": 30,
    "MaxRetries": 5,
    "RetryDelaySeconds": 60
  },
  "Backup": {
    "Enabled": true,
    "IntervalHours": 24,
    "RetentionCount": 10,
    "DataFolder": "",
    "BackupFolder": ""
  },
  "RocketChat": {
    "TimeoutSeconds": 30,
    "RoomIds": {
      "Docsvision": ""
    }
  },
  "RedmineLinkChecker": {
    "BaseUrl": "http://ticket-monitor-redmine:8082",
    "TimeoutSeconds": 5
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  }
}