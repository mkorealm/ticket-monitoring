{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "Redmine": {
    "BaseUrl": "http://redmine.example.ru/redmine",
    "DefaultProjectId": 18,
    "DefaultTrackerId": 3,
    "DefaultStatusId": 1,
    "DefaultPriorityId": 2,
    "DefaultDevelopmentEnvironment": "OTHER",
    "DefaultTechDebt": true,
    "PollingIntervalMinutes": 5,
    "FormBaseUrl": "http://ticket-monitor-redmine:8082/redmine/create",
    "CustomFieldHdNumber": 5,
    "CustomFieldTechDebt": 7,
    "CustomFieldDevEnvironment": 13,
    "PollingClosedStatusIds": [ 3, 5, 6, 11, 12 ],
    "AllowedProjectIds": [ 18, 46 ]
  },
  "GLPI": {
    "TimeoutSeconds": 30,
    "MaxRetries": 5,
    "RetryDelaySeconds": 60
  },
  "Operations": {
    "ServiceName": "TicketMonitor.Redmine",
    "DatabaseFileName": "operations.db",
    "RetentionDays": 30
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8082"
      }
    }
