{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "Watchdog": {
    "HealthCheckIntervalSeconds": 30,
    "OperationsCheckIntervalSeconds": 15,
    "FailureThreshold": 3,
    "HttpRawRetentionDays": 30,
    "HttpAggregateRetentionDays": 90,
    "OperationsAggregateRetentionDays": 90,
    "Services": [
      {
        "Name": "TicketMonitor.Api",
        "DisplayName": "TicketMonitor API",
        "HealthUrl": "http://ticketmonitor-api:8080/healthz",
        "BasePath": "/mnt/api",
        "OperationsDbFile": "operations.db"
      },
      {
        "Name": "TicketMonitor.Redmine",
        "DisplayName": "TicketMonitor Redmine",
        "HealthUrl": "http://ticketmonitor-redmine:8082/health",
        "BasePath": "/mnt/redmine",
        "OperationsDbFile": "operations.db"
      }
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8083"
      }
    }
  }
}